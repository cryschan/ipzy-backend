# ==========================================
# IPZY Backend Environment Variables
# ==========================================

# Database Configuration
DB_NAME=ipzy_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Server Configuration
SERVER_PORT=8080

# Kakao OAuth2 (https://developers.kakao.com)
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# Frontend URL (for OAuth2 redirect)
FRONTEND_URL=http://localhost:5173
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default

# Swagger Configuration
SWAGGER_SERVER_URL=http://localhost:8080

# Session Configuration
SESSION_TIMEOUT=30m

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000

# JPA & Hibernate
DDL_AUTO=validate
SHOW_SQL=false

# Logging
LOG_LEVEL=INFO

# Kakao OAuth2 (Required)
KAKAO_CLIENT_ID=your-kakao-client-id-here
KAKAO_CLIENT_SECRET=your-kakao-client-secret-here

# Frontend URL
FRONTEND_URL=http://localhost:5173
