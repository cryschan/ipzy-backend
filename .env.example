# Database Configuration (Required)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# JPA & Hibernate
DDL_AUTO=validate
SHOW_SQL=false

# Logging
LOG_LEVEL=INFO

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default

# Kakao OAuth2 (https://developers.kakao.com)
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# Frontend URL (for OAuth2 redirect)
FRONTEND_URL=http://localhost:5173

# Swagger Configuration
SWAGGER_SERVER_URL=http://localhost:8080

# Session Configuration
SESSION_TIMEOUT=30m

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000

# QuizSession 초기화 모드
QUIZ_SESSION_INIT_MODE=CLEAN

# QuizSession 정리 스케줄러 설정
QUIZ_SESSION_CLEANUP_ENABLED=true
QUIZ_SESSION_CLEANUP_CRON=0 0 4 * * *
QUIZ_SESSION_CLEANUP_EXPIRATION=PT24H

# AWS S3 Configuration (Required for AI service)
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=ap-northeast-2

# Subscription Scheduler (Phase 6)
SUBSCRIPTION_EXPIRATION_ENABLED=true
SUBSCRIPTION_EXPIRATION_CRON=0 0 2 * * *
SUBSCRIPTION_WARNING_ENABLED=true
SUBSCRIPTION_WARNING_CRON=0 0 10 * * *

# Subscription Token Management (Phase 5)
SUBSCRIPTION_TOKEN_RESET_ENABLED=true
SUBSCRIPTION_TOKEN_RESET_CRON=0 0 0 * * *
SUBSCRIPTION_FREE_DAILY_TOKENS=3
SUBSCRIPTION_BASIC_DAILY_TOKENS=10